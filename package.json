{
  "name": "@pipelex/mcp",
  "version": "0.7.0",
  "description": "Pipelex MCP servers for validating, preparing, and running MTHDS methods",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pipelex-mcp": "dist/local/main.js"
  },
  "files": [
    "dist/local",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "skybridge dev",
    "dev:local": "tsx src/local/main.ts",
    "inspect:local": "npx @modelcontextprotocol/inspector npx tsx src/local/main.ts",
    "dev:tunnel": "skybridge dev --tunnel",
    "lint": "eslint src/ vite.config.ts vitest.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{ts,tsx,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{ts,tsx,mjs}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run build && npm run build:local && npm run typecheck",
    "build": "skybridge build",
    "build:local": "tsup",
    "prepack": "npm run build:local",
    "start": "skybridge start",
    "deploy": "alpic deploy"
  },
  "dependencies": {
    "@alpic-ai/ui": "^1.122.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pipelex/mthds-ui": "^0.12.0",
    "@pipelex/sdk": "^0.4.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "skybridge": "^1.2.7",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@skybridge/devtools": "^1.2.7",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "alpic": "^1.104.1",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.2.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
