{
  "name": "@pipelex/mcp",
  "version": "0.19.0",
  "description": "The MCP server inside the Pipelex plugin: validate, prepare and run AI methods on Pipelex from a coding agent.",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "pipelex", "mthds", "ai-methods", "coding-agent", "claude-code", "codex", "cursor", "mistral-vibe"],
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pipelex/pipelex-mcp"
  },
  "type": "module",
  "bin": {
    "pipelex-mcp": "dist/local/main.js"
  },
  "files": [
    "dist/local",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "skybridge dev",
    "dev:local": "tsx src/local/main.ts",
    "inspect:local": "npx @modelcontextprotocol/inspector npx tsx src/local/main.ts",
    "dev:tunnel": "skybridge dev --tunnel",
    "lint": "eslint src/ scripts/ eslint-rules/ vite.config.ts vitest.config.ts vitest.e2e.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\" \"eslint-rules/**/*.mjs\" \"*.{ts,tsx,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\" \"eslint-rules/**/*.mjs\" \"*.{ts,tsx,mjs}\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "seed:e2e-fixture": "tsx --env-file-if-exists=.env scripts/seed-e2e-fixture.ts",
    "check": "npm run lint && npm run format:check && npm run check:tool-texts && npm run build && npm run check:bundle && npm run check:cascade && npm run build:local && npm run typecheck",
    "build": "skybridge build && node scripts/emit-server-bundle.mjs",
    "check:bundle": "node scripts/check-server-bundle.mjs",
    "check:cascade": "node scripts/check-cascade.mjs",
    "check:tool-texts": "tsx scripts/check-tool-texts.ts",
    "build:local": "tsup",
    "prepack": "npm run build:local",
    "start": "NODE_ENV=production node dist/server.bundle.js",
    "deploy": "alpic deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pipelex/sdk": "^0.25.1",
    "mthds": "^0.25.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@alpic-ai/ui": "^1.122.0",
    "@eslint/js": "^9.39.4",
    "@pipelex/mthds-ui": "^0.24.0",
    "@skybridge/devtools": "^1.4.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "alpic": "^1.104.1",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "lucide-react": "^1.14.0",
    "prettier": "^3.8.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "skybridge": "^1.4.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
