{
  "name": "@pipelex/mcp-console",
  "version": "0.19.0",
  "private": true,
  "description": "The Pipelex MCP: the hosted Skybridge console that chat hosts reach at mcp.pipelex.com, deployed to Alpic.",
  "license": "Elastic-2.0",
  "type": "module",
  "scripts": {
    "dev": "skybridge dev",
    "dev:tunnel": "skybridge dev --tunnel",
    "build": "skybridge build && node scripts/emit-server-bundle.mjs",
    "check:bundle": "node scripts/check-server-bundle.mjs",
    "check:cascade": "node scripts/check-cascade.mjs",
    "start": "NODE_ENV=production node dist/server.bundle.js"
  },
  "dependencies": {
    "@alpic-ai/ui": "^1.122.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pipelex/mthds-ui": "^0.24.0",
    "@pipelex/sdk": "^0.25.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "skybridge": "^1.4.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@pipelex/mcp-core": "0.0.0",
    "@skybridge/devtools": "^1.4.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "alpic": "^1.104.1",
    "vite": "^8.0.3"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
